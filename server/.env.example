# ==============================================================
# VeriWork Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values.
# NEVER commit real production secrets or .env files to Git.
# ==============================================================

# Server Network Configuration
PORT=5000
FRONTEND_URL=https://veriworkblockchain.netlify.app

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/veriwork?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key
ADMIN_API_KEY=replace_with_a_secure_admin_passkey_for_governance

# Ethereum Blockchain Configuration (Sepolia Network - Chain ID 11155111)
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_PRIVATE_KEY=replace_with_authorized_employer_or_relayer_private_key
BLOCKCHAIN_CONTRACT_ADDRESS=0xe2CC881c9aE8F1C6D1209C6171b84aeDB3134965

# Certificate PDF Generation (On-Demand Direct Streaming)
# Certificate PDFs are generated in memory and streamed directly via PDFKit.
# No external IPFS gateways or Pinata credentials are required.
